# ==========================================
# Evhayaliniz .gitignore
# ==========================================

# 1. Hassas Bilgiler ve Ortam Dosyaları
.env
.env.*
!.env.example
*.sql
*.key
auth.json

# 2. Demo / Staging Klasörü (Yerelde korunur, ana repoya girmez)
demo.evhayaliniz.com/

# 3. Bağımlılıklar (Composer & NPM paketleri)
**/vendor/
**/node_modules/

# 4. Kullanıcı Yüklemeleri ve Yedek Klasörleri (Depoyu şişirmemesi için)
**/uploads/
**/backups/
**/storage_yedek/
public_html/storage/
public_html/site/chat_files/
**/storage/app/private/*
**/storage/app/public/*
**/storage/app/purifier/*
!**/storage/app/.gitignore
!**/storage/app/public/.gitignore

# 5. Laravel Önbellek, Oturum ve Derleme Dosyaları
**/bootstrap/cache/*.php
!**/bootstrap/cache/.gitignore
**/storage/framework/cache/*
!**/storage/framework/cache/.gitignore
**/storage/framework/sessions/*
!**/storage/framework/sessions/.gitignore
**/storage/framework/views/*
!**/storage/framework/views/.gitignore
**/storage/pail/

# 6. Log ve Hata Kayıtları
*.log
**/storage/logs/*
!**/storage/logs/.gitignore
error_log*
**/error_log*
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# 7. Derlenmiş Frontend Çıktıları
**/public/hot
**/public/storage

# 8. IDE, Sistem ve Çöp Dosyaları
.idea/
.vscode/
.fleet/
.nova/
.zed/
.DS_Store
**/.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini
*.tmp
*.bak
*.swp

# 9. Test Önbellekleri
.phpunit.cache/
.phpunit.result.cache
Homestead.json
Homestead.yaml
.phpactor.json

# 10. Yerel Geliştirme (Local Dev / Docker)
docker-compose.yml
docker/
package.json

